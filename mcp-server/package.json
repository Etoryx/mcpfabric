{
  "name": "mcpfabric-mcp-server",
  "version": "0.5.0",
  "description": "MCP server that bridges AI agents to the mcpfabric Minecraft mod, exposing full read & control of the game as MCP tools.",
  "type": "module",
  "bin": {
    "mcpfabric": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"test/*.test.mjs\" \".test-build/test/*.test.js\"",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts"
  },
  "engines": {
    "node": ">=22.16"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "minecraft",
    "fabric",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
